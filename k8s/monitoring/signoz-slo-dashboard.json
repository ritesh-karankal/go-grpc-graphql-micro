                          "name": "A",
                          "query": "histogram_quantile(0.99, sum by (le) (rate({\"graphql.server.operation.duration.bucket\", operation=\"createOrder\", outcome=\"ok\", synthetic=\"$synthetic\"}[5m])))",
                          "disabled": false,
                          "step": 0,
                          "stats": false,
                          "legend": "p99"
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "B",
                          "query": "histogram_quantile(0.50, sum by (le) (rate({\"graphql.server.operation.duration.bucket\", operation=\"createOrder\", outcome=\"ok\", synthetic=\"$synthetic\"}[5m])))",
                          "disabled": false,
                          "step": 0,
