{
  "spec": {
    "display": {
      "name": "SLOs : go-micro-shop",
      "description": "SLIs, SLOs and error-budget burn for checkout and browse/search, from the gateway's OpenTelemetry metrics. See docs/SLO.md."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "synthetic",
            "description": "false = real users (the SLO); true = load tests / drills"
          },
          "allowAllValue": false,
          "allowMultiple": false,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "none",
          "plugin": {
            "kind": "signoz/CustomVariable",
            "spec": {
              "customValue": "true,false"
            }
          },
          "name": "synthetic"
        }
      }
    ],
    "panels": {
      "cd988334-f0e5-4d1a-8d87-78cf05afa7cd": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Checkout: availability SLI (target 99.5%)",
            "description": "ok / (ok + server_error) over 5 minutes"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "percentunit",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.95,
                "softMax": 1,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "promql",
                        "spec": {
                          "name": "A",
                          "query": "1 - ((sum(rate({\"graphql.server.operations\", operation=\"createOrder\", outcome=\"server_error\", synthetic=\"$synthetic\"}[5m])) or vector(0)) / sum(rate({\"graphql.server.operations\", operation=\"createOrder\", outcome=~\"ok|server_error\", synthetic=\"$synthetic\"}[5m])))",
                          "disabled": false,
                          "step": 0,
                          "stats": false,
                          "legend": "availability"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "571a8a46-971c-4706-9fb5-06d01bc51570": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Checkout: error-budget burn rate (page above 14.4)",
            "description": "error ratio / 0.005. 1 = budget used up exactly over 28 days; page when both windows exceed 14.4"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "promql",
                        "spec": {
                          "name": "A",
                          "query": "((sum(rate({\"graphql.server.operations\", operation=\"createOrder\", outcome=\"server_error\", synthetic=\"$synthetic\"}[1h])) or vector(0)) / sum(rate({\"graphql.server.operations\", operation=\"createOrder\", outcome=~\"ok|server_error\", synthetic=\"$synthetic\"}[1h]))) / 0.005",
                          "disabled": false,
                          "step": 0,
                          "stats": false,
                          "legend": "burn 1h"
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "B",
                          "query": "((sum(rate({\"graphql.server.operations\", operation=\"createOrder\", outcome=\"server_error\", synthetic=\"$synthetic\"}[5m])) or vector(0)) / sum(rate({\"graphql.server.operations\", operation=\"createOrder\", outcome=~\"ok|server_error\", synthetic=\"$synthetic\"}[5m]))) / 0.005",
                          "disabled": false,
                          "step": 0,
                          "stats": false,
                          "legend": "burn 5m"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "e2cba9aa-5893-4946-92d0-96d135b07d9d": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Checkout: latency SLI, share under 500 ms (target 99%)",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "percentunit",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0.95,
                "softMax": 1,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "promql",
                        "spec": {
                          "name": "A",
                          "query": "sum(rate({\"graphql.server.operation.duration.bucket\", operation=\"createOrder\", outcome=\"ok\", synthetic=\"$synthetic\", le=\"0.5\"}[5m])) / sum(rate({\"graphql.server.operation.duration.count\", operation=\"createOrder\", outcome=\"ok\", synthetic=\"$synthetic\"}[5m]))",
                          "disabled": false,
                          "step": 0,
                          "stats": false,
                          "legend": "under 500 ms"
                        }
