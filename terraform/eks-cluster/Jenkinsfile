properties([
    parameters([
        choice(
            choices: ['dev', 'prod'],
            name: 'Environment'
        ),
        choice(
            choices: ['plan', 'apply', 'destroy'],
            name: 'Terraform_Action'
        )])
])

pipeline {
    agent any

    // AWS access comes from the Jenkins EC2 instance role; no stored keys needed.
    environment {
        AWS_REGION       = 'eu-north-1'
        TF_DIR           = 'terraform/eks-cluster'
        TF_IN_AUTOMATION = 'true'
        AWS_ACCOUNT_ID   = credentials('AWS_ACCOUNT_ID')
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }

    stages {
        stage('Preparing') {
            steps {
                checkout scm
            }
        }

        stage('Init') {
            steps {
                sh '''
                    terraform -chdir=${TF_DIR} init -input=false -reconfigure \
                      -backend-config="bucket=go-grpc-micro-tfstate-${AWS_ACCOUNT_ID}" \
                      -backend-config="key=eks-cluster/${Environment}/terraform.tfstate"
                '''
            }
        }

        stage('Validate') {
            steps {
                sh 'terraform -chdir=${TF_DIR} validate'
            }
        }

        stage('Plan') {
            steps {
                script {
                    def destroyFlag = (params.Terraform_Action == 'destroy') ? '-destroy' : ''
                    sh """
                        terraform -chdir=\${TF_DIR} plan -input=false ${destroyFlag} \
                          -var-file=envs/\${Environment}.tfvars -out=tfplan
                    """
                }
            }
        }

        stage('Approve') {
            when {
                expression { params.Terraform_Action != 'plan' }
            }
            steps {
                input message: "Run terraform ${params.Terraform_Action} on the ${params.Environment} EKS cluster?", ok: 'Proceed'
            }
        }

        stage('Apply') {
            when {
                expression { params.Terraform_Action != 'plan' }
            }
            steps {
                sh 'terraform -chdir=${TF_DIR} apply -input=false tfplan'
            }
        }

        // The EKS API is private: Jenkins has no cluster access. Use the bastion.
        stage('Bastion Access') {
            when {
                expression { params.Terraform_Action == 'apply' }
            }
            steps {
                sh 'terraform -chdir=${TF_DIR} output -raw bastion_ssm_session'
            }
        }
    }
}
